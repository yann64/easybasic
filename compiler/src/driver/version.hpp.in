#pragma once

// Generated by CMake from version.hpp.in - do not edit the generated copy.

#define EASYBASIC_VERSION "@PROJECT_VERSION@"
#define EASYBASIC_GIT_HASH "@EASYBASIC_GIT_HASH@"

// Build-tree fallback so `pbcxx` run straight out of `build/<preset>/`
// (the normal dev/test workflow) finds the runtime headers without needing
// `cmake --install` first. A real relocatable-install lookup (resolving
// relative to the running executable's own path, mirroring eBasic's M8e
// trick) is M6's job, once Haiku/Windows packaging actually needs it.
#define EASYBASIC_BUILD_TREE_RUNTIME_INCLUDE_DIR "@CMAKE_SOURCE_DIR@/runtime/include"
